{
  "theme": "catppuccin-tui-mocha",
  "tuiMode": "fullscreen",
  "packages": [
    "npm:pi-catppuccin-tui",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "git:github.com/elpapi42/pi-fork",
    "git:github.com/MasuRii/pi-rtk-optimizer",
    "git:github.com/elpapi42/pi-observational-memory"
  ],
  "compaction": {
    "enabled": true
  },
  "hideThinkingBlock": true,
  "defaultProvider": "primary",
  "defaultThinkingLevel": "medium",
  "extensions": ["extensions/pi-model-aliases"],
  "pi-fork": {
    "extensions": [],
    "offline": true,
    "costFooter": true
  },
  "lastChangelogVersion": "0.87.1"
}