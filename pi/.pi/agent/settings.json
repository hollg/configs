{
  "theme": "catppuccin-tui-mocha",
  "tuiMode": "fullscreen",
  "packages": [
    "npm:pi-catppuccin-tui",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-clear",
    "git:github.com/elpapi42/pi-fork",
    "git:github.com/MasuRii/pi-rtk-optimizer",
    "git:github.com/elpapi42/pi-observational-memory",
    "git:github.com/elpapi42/pi-minimal-subagent"
  ],
  "compaction": {
    "enabled": true
  },
  "hideThinkingBlock": true,
  "defaultProvider": "primary",
  "defaultThinkingLevel": "medium",
  "extensions": ["extensions/pi-model-aliases"],
  "pi-fork": {
    "extensions": [],
    "offline": true,
    "costFooter": true
  },
  "pi-minimal-subagent": {
    "model": null,
    "extensions": ["extensions/pi-model-aliases"]
  },
  "lastChangelogVersion": "0.87.1"
}