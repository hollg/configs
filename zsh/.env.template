# Environment Variables Template
# Copy this file to .env and fill in your actual values
#
# Note: .env is gitignored and should never be committed.
# .zshenv sources .env on every shell start, so anything exported here
# is available to .zshrc and to programs launched from the shell.

# GitHub fine-grained PAT used to authenticate to the LEGO npm package
# registry. Referenced by ~/.npmrc as ${LEGO_GITHUB_PACKAGE_REGISTRY_TOKEN}.
export LEGO_GITHUB_PACKAGE_REGISTRY_TOKEN="your_token_here"

# GitHub fine-grained PAT used by mcp-hub to talk to GitHub MCP servers.
export MCP_HUB_GH_ACCESS_TOKEN="your_token_here"

# General-purpose GitHub fine-grained PAT (gh CLI, scripts, etc.).
export GITHUB_PERSONAL_ACCESS_TOKEN="your_token_here"

# LEGO MPS (Anthropic gateway) API key. Re-exported as ANTHROPIC_AUTH_TOKEN
# in .zshrc so Claude Code / the Anthropic SDK pick it up automatically.
export MPS_API_KEY="your_token_here"

# Add other environment variables as needed:
# export OPENAI_API_KEY="your_api_key_here"
# export AWS_ACCESS_KEY_ID="your_aws_key_here"
# export DATABASE_URL="your_database_url_here"
